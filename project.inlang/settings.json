{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "en",
	"locales": [
		"en",
		"de"
	],
	"modules": [
		"./node_modules/@inlang/plugin-message-format/dist/index.js"
	],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./messages/{locale}.json",
			"./src/concepts/high-school/function-shifts/messages/{locale}.json",
			"./src/concepts/high-school/sine-cosine-graphs/messages/{locale}.json",
			"./src/concepts/high-school/tangent/messages/{locale}.json",
			"./src/concepts/high-school/trig-identities/messages/{locale}.json"
		]
	}
}
